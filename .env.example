# Schema Mapping Studio — environment configuration
ENV=development
PORT=8080
LOG_LEVEL=INFO

# Security — change in production
API_KEY=changeme-in-production

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_MAX_RETRIES=3

# Database (SQLite default; swap for postgresql+asyncpg:// in production)
DATABASE_URL=sqlite+aiosqlite:///./data/sms.db

# JSONata runner
NODE_BINARY=node
JSONATA_SCRIPT=scripts/jsonata_runner.js
JSONATA_TIMEOUT=10
PAYLOAD_MAX_BYTES=51200
